map $uri $bridge_csp {
    "/bridge-minimal.html" "frame-ancestors https://web.DOMAIN_REPLACE_ME https://sso.DOMAIN_REPLACE_ME";
    "/bridge-sand.html"    "frame-ancestors https://pad.DOMAIN_REPLACE_ME https://web.DOMAIN_REPLACE_ME https://sso.DOMAIN_REPLACE_ME";
    default                "";
}

server {
    listen 80;
    listen [::]:80;
    server_name pad.DOMAIN_REPLACE_ME sand.DOMAIN_REPLACE_ME;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name pad.DOMAIN_REPLACE_ME sand.DOMAIN_REPLACE_ME;

    # Certificats Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/pad.DOMAIN_REPLACE_ME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pad.DOMAIN_REPLACE_ME/privkey.pem;

    ssl_dhparam /etc/nginx/dhparam.pem; # if doesn' exist : openssl dhparam -out /etc/nginx/dhparam.pem 2048

    # Optimisation SSL & HSTS
    ssl_session_timeout 1d;
    ssl_session_cache shared:MozSSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 150m;
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    # =============================================================
    # AURION RULES & ALIASES
    # =============================================================
    location = /login {
        if ($arg_from != "aurion") {
            return 302 https://web.DOMAIN_REPLACE_ME;
        }

        proxy_pass http://127.0.0.1:3010;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
    }

    # Alias /bridge-minimal.html
    location = /bridge-minimal.html {
        alias /home/aurion/aurionmail/bridges/cryptpad_main_bridge.html;
        add_header Content-Security-Policy $bridge_csp always;
    }

    # Alias /bridge-sand.html
    location = /bridge-sand.html {
        alias /home/aurion/aurionmail/bridges/cryptpad_sandbox_bridge.html;
        add_header Content-Security-Policy $bridge_csp always;
    }

    location ^~ /cryptpad_websocket {
        proxy_pass http://127.0.0.1:3013;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
    }

    error_log /var/log/nginx/cryptpad_error.log;
    access_log /var/log/nginx/cryptpad_access.log;
}